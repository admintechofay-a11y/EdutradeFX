# App Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edutrade_fx?schema=public

# JWT Secrets (Minimum 64 characters recommended for security)
JWT_ACCESS_SECRET=edutrade_super_secret_access_key_minimum_64_characters_long_forex_platform_2025
JWT_REFRESH_SECRET=edutrade_super_secret_refresh_key_minimum_64_characters_long_forex_platform_2025
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@edutradefx.com
SMTP_PASS=app_password_placeholder
FROM_EMAIL=noreply@edutradefx.com
FROM_NAME="EdutradeFX Platform"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=edutradefx-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Anthropic Claude AI Assistant
ANTHROPIC_API_KEY=sk-ant-api03-placeholder_key

# Admin Default Seed Credentials
ADMIN_EMAIL=admin@edutradefx.com
ADMIN_PASSWORD=Admin@1234!
