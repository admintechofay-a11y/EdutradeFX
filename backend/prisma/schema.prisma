generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────

enum Role {
  ADMIN
  BROKER
  ACCOUNT_MANAGER
  SIGNAL_PROVIDER
  TUTOR
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BrokerBusinessType {
  RETAIL
  ECN
  STP
  NDD
  MARKET_MAKER
  INSTITUTIONAL
  OTHER
}

enum BrokerOnboardingStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  VERIFIED
}

enum BrokerDocType {
  REGULATORY_LICENSE
  LICENSE_PROOF
  OFFICE_IMAGE
  COMMISSION_STRUCTURE
  SWAP_STRUCTURE
  PROMO_VIDEO
  POLICY_CLIENT
  POLICY_AML
  POLICY_RISK_DISCLOSURE
  POLICY_DEPOSIT
  POLICY_WITHDRAWAL
  POLICY_TERMS
  POLICY_IB_REBATE
  POLICY_SCALPING
  POLICY_SLIPPAGE_MARKUP
  POLICY_SERVICE
  POLICY_SERVER
  POLICY_OTHER
}

enum SpreadType {
  FLOATING
  FIXED
}

enum OrderExecution {
  INSTANT
  REQUEST
}

enum GtcMode {
  AVAILABLE
  UNAVAILABLE
}

enum IbSettlement {
  INSTANT
  DAILY
  WEEKLY
  MONTHLY
}

enum BrokerOptionGroup {
  REGULATOR
  LANGUAGE
  CURRENCY
  LICENSE_STATUS
  DEPOSIT_BONUS
  LEVERAGE
  TIMEFRAME
}

model BrokerOption {
  id        String            @id @default(uuid())
  group     BrokerOptionGroup
  code      String
  label     String
  meta      Json?
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([group, code])
  @@index([group, isActive])
}

enum CourseStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  PDF
  QUIZ
  TEXT
}

enum SignalDirection {
  BUY
  SELL
}

enum SignalStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ComplaintTargetType {
  BROKER
  ACCOUNT_MANAGER
  SIGNAL_PROVIDER
  TUTOR
  PLATFORM
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AdPlacement {
  HOME_HERO
  HOME_SIDEBAR
  BROKER_LIST
  COURSE_LIST
  BLOG_SIDEBAR
  POPUP
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
  APPROVAL
  REJECTION
  PAYMENT
  REVIEW
  ENQUIRY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EnquiryTargetType {
  BROKER
  ACCOUNT_MANAGER
  SIGNAL_PROVIDER
}

// ─── USER & AUTH ─────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(STUDENT)
  avatar            String?
  phone             String?
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  refreshTokens     RefreshToken[]
  broker            Broker?
  accountManager    AccountManager?
  signalProvider    SignalProvider?
  tutor             Tutor?
  enrollments       Enrollment[]
  brokerReviews     BrokerReview[]
  amReviews         AccountManagerReview[]
  spReviews         SignalProviderReview[]
  courseReviews     CourseReview[]
  complaints        Complaint[]
  savedBrokers      SavedBroker[]
  wishlistCourses   WishlistCourse[]
  notifications     Notification[]
  blogPosts         BlogPost[]
  enquiries         Enquiry[]
  comparisons       BrokerComparison[]
  orders            Order[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
}

// ─── BROKER MARKETPLACE ──────────────────────────────

model Broker {
  id               String         @id @default(uuid())
  userId           String         @unique
  companyName      String
  slug             String         @unique
  logo             String?
  website          String?
  description      String?        @db.Text
  yearFounded      Int?
  headquarters     String?
  countries        String[]
  regulation       String[]
  tradingPlatforms String[]
  accountTypes     String[]
  minDeposit       Float?
  maxLeverage      String?
  spreadsFrom      String?
  commissions      String?
  instruments      String[]
  depositMethods   String[]
  withdrawMethods  String[]
  executionType    String?
  riskDisclaimer   String?        @db.Text
  avgRating        Float          @default(0)
  totalReviews     Int            @default(0)
  totalLeads       Int            @default(0)
  status           ApprovalStatus @default(PENDING)
  isFeatured       Boolean        @default(false)
  isPremium        Boolean        @default(false)
  featuredUntil    DateTime?
  seoTitle         String?
  seoDescription   String?

  // ── Extended Onboarding V2 Fields ──
  registeredName             String?
  businessType               BrokerBusinessType?
  platformDescription        String?                @db.Text
  address                    String?                @db.Text
  city                       String?
  state                      String?
  postalCode                 String?
  country                    String?
  phone                      String?
  email                      String?
  mtRegisteredCountryRegion  String?
  isRegulated                Boolean?
  totalTradableSymbols       Int?
  accountCurrencies          String[]               @default([])
  negativeBalanceProtection Boolean?
  availablePlatforms         String[]               @default([])
  platformLinks              Json?
  deviceSupport              String[]               @default([])
  availableTimeframes        String[]               @default([])

  // Company
  officeContactNumber        String?
  officeContactEmail         String?

  // Services
  countryRestrictions        String[]               @default([])
  supportPhone               String?
  supportWhatsapp            String?
  supportEmail               String?
  supportAvailability        String?
  languagesSupported         String[]               @default([])

  // Security
  clientLossPercentage       Decimal?               @db.Decimal(5, 2)
  fundsSecurity              String?                @db.Text

  // Dealing & Business
  liquidityProvider          String?
  personalBookSize           String?

  // Content
  prosList                   String[]               @default([])
  consList                   String[]               @default([])
  promoVideoUrl              String?
  socialLinks                Json?

  // Workflow
  onboardingStatus           BrokerOnboardingStatus @default(DRAFT)
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewNote                 String?                @db.Text
  rejectionReason            String?                @db.Text
  completenessPct            Int                    @default(0)

  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                  BrokerDocument[]
  reviews                    BrokerReview[]
  savedBy                    SavedBroker[]
  comparisons                BrokerComparisonItem[]
  advertisements             Advertisement[]
  leads                      BrokerLead[]

  // Child Relations V2
  servers                    BrokerServer[]
  licenses                   BrokerLicense[]
  boardMembers               BrokerBoardMember[]
  accountGroups              BrokerAccountGroup[]
  ibPlans                    BrokerIbPlan[]
  depositMethodItems         BrokerDepositMethod[]
  withdrawalMethodItems      BrokerWithdrawalMethod[]
  symbolSpecs                BrokerSymbolSpec[]
  fundingYears               BrokerFundingYear[]
  clientActivity             BrokerClientActivity?
  businessAreas              BrokerBusinessArea[]
  awards                     BrokerAward[]

  @@index([status])
  @@index([isFeatured])
  @@index([avgRating])
  @@index([isRegulated])
  @@index([businessType])
  @@index([country])
  @@index([onboardingStatus])
}

model BrokerDocument {
  id              String        @id @default(uuid())
  brokerId        String
  fileUrl         String
  fileName        String
  fileType        String
  docType         BrokerDocType @default(REGULATORY_LICENSE)
  isPrivate       Boolean       @default(false)
  verifiedByAdmin Boolean       @default(false)
  createdAt       DateTime      @default(now())
  broker          Broker        @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([docType])
}

model BrokerServer {
  id        String   @id @default(uuid())
  brokerId  String
  name      String
  ip        String?
  location  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerLicense {
  id              String    @id @default(uuid())
  brokerId        String
  regulatoryBody  String
  regulatorCode   String?
  regulatorOther  String?
  licenseNumber   String
  licenseStatus   String    @default("Active")
  companyAddress  String?   @db.Text
  licensePdfUrl   String?
  proofUrl        String?
  proofLink       String?
  verifiedByAdmin Boolean   @default(false)
  verifiedAt      DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  broker          Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@index([regulatoryBody])
  @@index([licenseStatus])
  @@index([regulatorCode])
}

model BrokerBoardMember {
  id          String   @id @default(uuid())
  brokerId    String
  name        String
  designation String
  experience  String?
  photoUrl    String?
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  broker      Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerAccountGroup {
  id                     String             @id @default(uuid())
  brokerId               String
  name                   String
  demoAvailable          Boolean            @default(false)
  currency               String             @default("USD")
  spreadTypesLabel       String?
  spreadFrom             Decimal            @default(0) @db.Decimal(6, 2)
  minDeposit             Decimal            @default(0) @db.Decimal(10, 2)
  depositBonusPctUpTo    Decimal            @default(0) @db.Decimal(5, 2)
  depositBonusCode       String?
  depositBonusNum        Int?
  leverageUpTo           String             @default("1:500")
  leverageNum            Int?
  minTradeVolume         Decimal            @default(0.01) @db.Decimal(8, 2)
  hasCommissionPerLot    Boolean            @default(false)
  feesPerLot             Decimal?           @db.Decimal(8, 2)
  commissionStructureUrl String?
  spreadType             SpreadType         @default(FLOATING)
  orderTypes             String[]           @default([])
  swapFree               Boolean            @default(false)
  swapLong               String?
  swapShort              String?
  orderExecution         OrderExecution     @default(INSTANT)
  gtcMode                GtcMode            @default(AVAILABLE)
  eaAllowed              Boolean            @default(true)
  hedgingAllowed         Boolean            @default(true)
  nettingAllowed         Boolean            @default(false)
  scalpingAllowed        Boolean            @default(true)
  hasSwapCharges         Boolean            @default(true)
  swapStructureUrl       String?
  slippage               Boolean            @default(false)
  slippagePoints         String?
  markups                String?
  forexCommission        Json?
  cryptoCommission       String?
  commoditiesCommission  String?
  metalsCommission       String?
  indexCommission        String?
  stocksCommission       String?
  testLogin              String?
  testPasswordEnc        String?
  testServer             String?
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  broker                 Broker             @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  symbolSpecs            BrokerSymbolSpec[]

  @@index([brokerId])
}

model BrokerIbPlan {
  id               String   @id @default(uuid())
  brokerId         String
  accountGroupName String
  settlement       String[] @default([])
  rebatePerLot     Decimal  @default(0) @db.Decimal(10, 2)
  levelsUpTo       Int      @default(1)
  customizable     Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  broker           Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerDepositMethod {
  id              String   @id @default(uuid())
  brokerId        String
  method          String
  charges         String?
  exchangeRate    String?
  timeTaken       String?
  extraFacilities String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  broker          Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerWithdrawalMethod {
  id                String   @id @default(uuid())
  brokerId          String
  method            String
  charges           String?
  exchangeRate      String?
  timeTaken         String?
  extraFacilities   String?
  delayCompensation String?  @db.Text
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  broker            Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerSymbolSpec {
  id             String              @id @default(uuid())
  brokerId       String
  accountGroupId String?
  symbol         String
  contractSize   String?
  digits         Int                 @default(5)
  stopLevel      String?
  stopOutPct     String?
  commission     String?
  spreadType     String?
  spreadFrom     String?
  minVolume      Decimal             @default(0.01) @db.Decimal(8, 2)
  maxVolume      Decimal             @default(100.00) @db.Decimal(8, 2)
  swapLong       String?
  swapShort      String?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  broker         Broker              @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  accountGroup   BrokerAccountGroup? @relation(fields: [accountGroupId], references: [id], onDelete: SetNull)

  @@index([brokerId])
  @@index([accountGroupId])
  @@index([symbol])
}

model BrokerFundingYear {
  id             String   @id @default(uuid())
  brokerId       String
  year           Int
  netDepositUsd  Decimal  @default(0) @db.Decimal(20, 2)
  netWithdrawUsd Decimal  @default(0) @db.Decimal(20, 2)
  netLots        Decimal  @default(0) @db.Decimal(20, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  broker         Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([brokerId, year])
  @@index([brokerId])
}

model BrokerClientActivity {
  id                          String   @id @default(uuid())
  brokerId                    String   @unique
  avgNewClientDeposit         Decimal  @default(0) @db.Decimal(12, 2)
  avgExistingClientDeposit    Decimal  @default(0) @db.Decimal(12, 2)
  avgNewClientWithdrawal      Decimal  @default(0) @db.Decimal(12, 2)
  avgExistingClientWithdrawal Decimal  @default(0) @db.Decimal(12, 2)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  broker                      Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerBusinessArea {
  id              String   @id @default(uuid())
  brokerId        String
  countryOrRegion String
  clientsNote     String?  @db.Text
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  broker          Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerAward {
  id           String    @id @default(uuid())
  brokerId     String
  year         Int
  awardFor     String
  expo         String?
  expoLocation String?
  expoDate     DateTime?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  broker       Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
}

model BrokerReview {
  id              String   @id @default(uuid())
  brokerId        String
  userId          String
  rating          Float
  title           String
  comment         String   @db.Text
  pros            String?
  cons            String?
  isVerified      Boolean  @default(false)
  isApproved      Boolean  @default(false)
  brokerResponse  String?  @db.Text
  respondedAt     DateTime?
  helpfulCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  broker          Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brokerId, userId])
  @@index([brokerId])
  @@index([userId])
}

model BrokerLead {
  id         String   @id @default(uuid())
  brokerId   String
  name       String
  email      String
  phone      String?
  message    String?  @db.Text
  source     String?
  createdAt  DateTime @default(now())
  broker     Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
}

model SavedBroker {
  id        String   @id @default(uuid())
  userId    String
  brokerId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  @@unique([userId, brokerId])
}

model BrokerComparison {
  id        String                 @id @default(uuid())
  userId    String?
  sessionId String?
  createdAt DateTime               @default(now())
  user      User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     BrokerComparisonItem[]
}

model BrokerComparisonItem {
  id           String           @id @default(uuid())
  comparisonId String
  brokerId     String
  comparison   BrokerComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  broker       Broker           @relation(fields: [brokerId], references: [id], onDelete: Cascade)
}

// ─── ACCOUNT MANAGER DIRECTORY ───────────────────────

model AccountManager {
  id               String         @id @default(uuid())
  userId           String         @unique
  fullName         String
  slug             String         @unique
  photo            String?
  tagline          String?
  bio              String?        @db.Text
  expertise        String[]
  languages        String[]
  country          String?
  city             String?
  yearsExperience  Int?
  services         String[]
  availability     String?
  strategy         String?
  minInvestment    Float?
  historicalPerformance String? @db.Text
  riskInfo         String?
  tradingStyle     String?
  website          String?
  disclaimer       String?        @db.Text
  avgRating        Float          @default(0)
  totalReviews     Int            @default(0)
  status           ApprovalStatus @default(PENDING)
  isFeatured       Boolean        @default(false)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        AccountManagerDocument[]
  reviews          AccountManagerReview[]
  enquiries        Enquiry[]

  @@index([status])
  @@index([isFeatured])
  @@index([avgRating])
}

model AccountManagerDocument {
  id               String         @id @default(uuid())
  accountManagerId String
  fileUrl          String
  fileName         String
  docType          String
  createdAt        DateTime       @default(now())
  accountManager   AccountManager @relation(fields: [accountManagerId], references: [id], onDelete: Cascade)
}

model AccountManagerReview {
  id               String         @id @default(uuid())
  accountManagerId String
  userId           String
  rating           Float
  comment          String         @db.Text
  isApproved       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  accountManager   AccountManager @relation(fields: [accountManagerId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountManagerId, userId])
  @@index([accountManagerId])
  @@index([userId])
}

// ─── SIGNAL PROVIDER DIRECTORY ───────────────────────

model SignalProvider {
  id               String         @id @default(uuid())
  userId           String         @unique
  displayName      String
  slug             String         @unique
  photo            String?
  bio              String?        @db.Text
  instruments      String[]
  strategy         String?
  riskCategory     String?
  winRate          Float?
  totalSignals     Int            @default(0)
  subscriptionPrice Float?
  historicalPerformance String?   @db.Text
  website          String?
  disclaimer       String?        @db.Text
  avgRating        Float          @default(0)
  totalReviews     Int            @default(0)
  verificationStatus Boolean      @default(false)
  status           ApprovalStatus @default(PENDING)
  isFeatured       Boolean        @default(false)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        SignalProviderDocument[]
  signals          Signal[]
  reviews          SignalProviderReview[]
  enquiries        Enquiry[]

  @@index([status])
  @@index([isFeatured])
  @@index([avgRating])
}

model SignalProviderDocument {
  id               String         @id @default(uuid())
  signalProviderId String
  fileUrl          String
  fileName         String
  docType          String
  createdAt        DateTime       @default(now())
  signalProvider   SignalProvider @relation(fields: [signalProviderId], references: [id], onDelete: Cascade)
}

model Signal {
  id               String         @id @default(uuid())
  signalProviderId String
  title            String
  instrument       String
  direction        SignalDirection
  entryPrice       Float?
  takeProfit       Float?
  stopLoss         Float?
  description      String?        @db.Text
  status           SignalStatus   @default(ACTIVE)
  closedAt         DateTime?
  closedPrice      Float?
  pipsGained       Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  signalProvider   SignalProvider @relation(fields: [signalProviderId], references: [id], onDelete: Cascade)

  @@index([signalProviderId])
  @@index([status])
  @@index([createdAt])
}

model SignalProviderReview {
  id               String         @id @default(uuid())
  signalProviderId String
  userId           String
  rating           Float
  comment          String         @db.Text
  isApproved       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  signalProvider   SignalProvider @relation(fields: [signalProviderId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalProviderId, userId])
  @@index([signalProviderId])
  @@index([userId])
}

// ─── LMS MARKETPLACE ─────────────────────────────────

model Tutor {
  id          String         @id @default(uuid())
  userId      String         @unique
  slug        String         @unique
  bio         String?        @db.Text
  photo       String?
  expertise   String[]
  totalEarned Float          @default(0)
  totalSales  Int            @default(0)
  avgRating   Float          @default(0)
  status      ApprovalStatus @default(PENDING)
  bankDetails Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   TutorDocument[]
  courses     Course[]
  payouts     Payout[]
}

model TutorDocument {
  id        String   @id @default(uuid())
  tutorId   String
  fileUrl   String
  fileName  String
  docType   String
  createdAt DateTime @default(now())
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model Course {
  id                String       @id @default(uuid())
  tutorId           String
  title             String
  slug              String       @unique
  description       String       @db.Text
  shortDescription  String?
  category          String
  level             String
  thumbnail         String?
  promoVideo        String?
  price             Float        @default(0)
  discountPrice     Float?
  discountUntil     DateTime?
  currency          String       @default("INR")
  prerequisites     String[]
  learningOutcomes  String[]
  language          String       @default("English")
  totalDuration     Int          @default(0)
  totalLessons      Int          @default(0)
  totalEnrollments  Int          @default(0)
  avgRating         Float        @default(0)
  totalReviews      Int          @default(0)
  status            CourseStatus @default(DRAFT)
  rejectionReason   String?
  isFeatured        Boolean      @default(false)
  seoTitle          String?
  seoDescription    String?
  platformCommission Float       @default(20)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tutor             Tutor          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  sections          CourseSection[]
  enrollments       Enrollment[]
  reviews           CourseReview[]
  orders            Order[]
  wishlistedBy      WishlistCourse[]
  advertisements    Advertisement[]

  @@index([tutorId])
  @@index([status])
  @@index([category])
  @@index([price])
  @@index([avgRating])
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id          String      @id @default(uuid())
  sectionId   String
  title       String
  type        LessonType  @default(VIDEO)
  contentUrl  String?
  duration    Int?
  description String?     @db.Text
  order       Int
  isFree      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
}

model Enrollment {
  id                String     @id @default(uuid())
  courseId          String
  userId            String
  orderId           String?
  progress          Float      @default(0)
  certificateIssued Boolean    @default(false)
  certificateUrl    String?
  enrolledAt        DateTime   @default(now())
  completedAt       DateTime?
  course            Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonCompletions LessonCompletion[]

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
}

model LessonCompletion {
  id           String     @id @default(uuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([enrollmentId, lessonId])
}

model CourseReview {
  id         String   @id @default(uuid())
  courseId   String
  userId     String
  rating     Float
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
}

model WishlistCourse {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  courseId          String
  amount            Float
  currency          String      @default("INR")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model Payout {
  id          String       @id @default(uuid())
  tutorId     String
  amount      Float
  currency    String       @default("INR")
  status      PayoutStatus @default(PENDING)
  notes       String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  tutor       Tutor        @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  @@index([tutorId])
  @@index([status])
  @@index([createdAt])
}

// ─── ENQUIRIES ────────────────────────────────────────

model Enquiry {
  id               String            @id @default(uuid())
  userId           String?
  name             String
  email            String
  phone            String?
  message          String            @db.Text
  targetType       EnquiryTargetType
  accountManagerId String?
  signalProviderId String?
  isRead           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountManager   AccountManager?   @relation(fields: [accountManagerId], references: [id], onDelete: SetNull)
  signalProvider   SignalProvider?   @relation(fields: [signalProviderId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([isRead])
  @@index([createdAt])
}

// ─── COMPLAINT BOX ───────────────────────────────────

model Complaint {
  id                 String              @id @default(uuid())
  userId             String?
  name               String
  email              String
  phone              String?
  companyName        String?
  category           String?
  targetType         ComplaintTargetType
  targetId           String?
  subject            String
  description        String              @db.Text
  attachments        String[]
  declarationConsent Boolean             @default(false)
  status             ComplaintStatus     @default(OPEN)
  assignedTo         String?
  adminNotes         String?             @db.Text
  resolution         String?             @db.Text
  resolvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([targetType])
  @@index([createdAt])
  @@index([email])
}

// ─── CONTACT ENQUIRIES ───────────────────────────────

enum ContactEnquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactEnquiry {
  id         String               @id @default(uuid())
  name       String
  email      String
  phone      String?
  category   String
  subject    String
  message    String               @db.Text
  status     ContactEnquiryStatus @default(PENDING)
  adminNotes String?              @db.Text
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ─── ADVERTISEMENTS ──────────────────────────────────

model Advertisement {
  id          String      @id @default(uuid())
  title       String
  imageUrl    String
  linkUrl     String
  placement   AdPlacement
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  brokerId    String?
  courseId    String?
  createdAt   DateTime    @default(now())
  broker      Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

// ─── BLOG ────────────────────────────────────────────

model BlogPost {
  id             String     @id @default(uuid())
  authorId       String
  title          String
  slug           String     @unique
  excerpt        String?
  content        String     @db.Text
  category       String
  tags           String[]
  featuredImage  String?
  seoTitle       String?
  seoDescription String?
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  viewCount      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  author         User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

// ─── NOTIFICATIONS ───────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── AI CHAT HISTORY ────────────────────────────────

model AIChatHistory {
  id        String   @id @default(uuid())
  sessionId String
  userId    String?
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())
}

// ─── AUDIT LOGGING ───────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

// ─── SITE SETTINGS ──────────────────────────────────

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
