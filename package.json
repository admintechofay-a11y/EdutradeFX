{
  "name": "edutrade-fx-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EdutradeFX — Production-ready Forex Marketplace, Education & Trading Ecosystem",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm --prefix backend run start\" \"npm --prefix frontend run start\"",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "prisma:push": "npm --prefix backend run db:push",
    "prisma:seed": "npm --prefix backend run db:seed",
    "prisma:generate": "npm --prefix backend run db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "keywords": [
    "forex",
    "marketplace",
    "lms",
    "trading",
    "education"
  ],
  "author": "Techofay Global Ventures",
  "license": "ISC",
  "dependencies": {
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4"
  }
}
